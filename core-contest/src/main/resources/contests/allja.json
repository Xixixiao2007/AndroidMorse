{
  "schemaVersion": 1,
  "id": "allja",
  "name": "JARL ALL JA",
  "duration": { "default": 30, "min": 1, "max": 60 },
  "runModes": ["single-call", "pile-up"],
  "constants": {},
  "exchange": {
    "myFields": [
      { "key": "rst", "type": "rst", "label": "RST" },
      { "key": "pref", "type": "text", "label": "Number" }
    ],
    "their": {
      "dice": [],
      "bindings": {
        "hisNumber": { "source": "history", "column": "number" }
      },
      "exch1": "'599'",
      "exch2": "upper(hisNumber)"
    }
  },
  "validation": [
    { "field": "rst", "when": "not matches(upper(rst), '^[1-5E][1-9N][1-9N]$')", "error": "RST must be three characters" },
    { "field": "pref", "when": "not matches(upper(pref), '^([0-9AOTN]*)([LMHP])$') or len(pref) > 4", "error": "Number must be a prefecture code and a power letter, up to 4" }
  ],
  "scoring": {
    "points": "1",
    "multipliers": [
      { "key": "ifElse(matches(theirExch2, '[LMHP]$'), substr(theirExch2, 1, len(theirExch2) - 1), theirExch2)" }
    ]
  },
  "callHistory": {
    "asset": "JARL_ALLJA.TXT",
    "delimiter": ",",
    "skipPrefixes": ["!!Order!!", "#"],
    "minFields": 2,
    "columns": [
      { "name": "call", "index": 0, "type": "callsign", "required": true },
      { "name": "number", "index": 1, "type": "text", "required": true },
      { "name": "userText", "index": 2, "type": "text" }
    ],
    "dedupe": false,
    "requiresMyCallInDxcc": false
  },
  "station": {
    "callPool": "MASTER.DTA",
    "speedRange": { "min": "speed - 5", "max": "speed + 10" },
    "exchangeDefaults": { "rst": "5NN", "pref": "10H" }
  },
  "messages": {},
  "capabilities": { "farnsworth": false, "requiresMyDxcc": false }
}
