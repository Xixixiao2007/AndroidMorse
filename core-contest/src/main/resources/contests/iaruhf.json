{
  "schemaVersion": 1,
  "id": "iaruhf",
  "name": "IARU HF World Championship",
  "duration": { "default": 30, "min": 1, "max": 60 },
  "runModes": ["single-call", "pile-up"],
  "constants": {},
  "exchange": {
    "myFields": [
      { "key": "rst", "type": "rst", "label": "RST", "send": "599" },
      { "key": "itu", "type": "text", "label": "ITU Zone or IARU Society" }
    ],
    "their": {
      "dice": [],
      "bindings": {
        "hisSect": { "source": "history", "column": "section" }
      },
      "exch1": "'599'",
      "exch2": "hisSect"
    }
  },
  "validation": [
    { "field": "itu", "when": "len(itu) == 0", "error": "Enter your ITU zone or your IARU society" },
    { "field": "rst", "when": "not matches(rst, '^[1-5][0-9]{2}$')", "error": "RST must be three digits" }
  ],
  "scoring": {
    "points": "ifElse(theirExch2 == itu or not matches(theirExch2, '^[0-9]+$'), 1, ifElse(callContinent(theirCall) == myContinent, 3, 5))",
    "multipliers": [
      { "key": "theirExch2" }
    ]
  },
  "callHistory": {
    "asset": "IARU_HF.txt",
    "delimiter": ",",
    "skipPrefixes": ["#"],
    "header": {
      "marker": "!!Order!!",
      "names": { "call": "Call", "section": "Sect", "userText": "UserText" }
    },
    "minFields": 3,
    "columns": [
      { "name": "call", "type": "callsign", "required": true },
      { "name": "section", "type": "text", "required": true },
      { "name": "userText", "type": "text" }
    ],
    "dedupe": true,
    "requiresMyCallInDxcc": true
  },
  "station": {
    "callPool": "MASTER.DTA",
    "speedRange": { "min": "speed - 5", "max": "speed + 10" },
    "exchangeDefaults": { "rst": "599" }
  },
  "messages": {},
  "capabilities": { "farnsworth": false, "requiresMyDxcc": true }
}
