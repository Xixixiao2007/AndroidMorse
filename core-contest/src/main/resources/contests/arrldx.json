{
  "schemaVersion": 1,
  "id": "arrldx",
  "name": "ARRL DX CW",
  "duration": { "default": 30, "min": 1, "max": 60 },
  "runModes": ["single-call", "pile-up"],
  "constants": {},
  "exchange": {
    "myFields": [
      { "key": "rst", "type": "rst", "label": "RST" },
      { "key": "exch2", "type": "text", "label": "State/Prov or Power" }
    ],
    "sent": {
      "exch1": "rst",
      "exch2": "exch2"
    },
    "their": {
      "dice": [],
      "bindings": {
        "hisState": { "source": "history", "column": "state" },
        "hisPower": { "source": "history", "column": "power" }
      },
      "exch1": "'599'",
      "exch2": "hisState + hisPower"
    }
  },
  "validation": [
    { "field": "rst", "when": "not matches(upper(rst), '^[1-5E][1-9N][1-9N]$')", "error": "RST must be three characters" },
    { "field": "exch2", "when": "len(exch2) == 0", "error": "Send your state/province (W/VE) or your power (DX)" }
  ],
  "scoring": {
    "points": "3",
    "multipliers": [
      {
        "key": "ifElse(myCountry == 'United States of America' or myCountry == 'Canada', callCountry(theirCall), theirExch2)"
      }
    ]
  },
  "callHistory": {
    "asset": "ARRLDXCW_USDX.txt",
    "delimiter": ",",
    "skipPrefixes": ["#"],
    "header": {
      "marker": "!!Order!!",
      "names": { "call": "Call", "name": "Name", "state": "State", "power": "Power", "userText": "UserText" }
    },
    "minFields": 4,
    "columns": [
      { "name": "call", "type": "callsign", "required": true },
      { "name": "name", "type": "text" },
      { "name": "state", "type": "text" },
      { "name": "power", "type": "text" },
      { "name": "userText", "type": "text" }
    ],
    "dedupe": false,
    "requiresMyCallInDxcc": false,
    "filter": "ifElse(myCountry == 'United States of America' or myCountry == 'Canada', power != '', state != '')"
  },
  "station": {
    "callPool": "MASTER.DTA",
    "speedRange": { "min": "speed - 5", "max": "speed + 10" },
    "exchangeDefaults": { "rst": "5NN", "exch2": "" }
  },
  "messages": {},
  "capabilities": { "farnsworth": false, "requiresMyDxcc": true }
}
