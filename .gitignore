# Ignore third-party reference clones and scratch
upstream/
.scratch/*
!/.scratch/.gitkeep
node_modules/
*.log

# Gradle / Android build output
.gradle/
.kotlin/
build/
local.properties
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab

# Vendored toolchain: the Gradle distribution lives on disk, not in history.
# 274 MB of jars in git is why the first push could not complete.  The small
# scripts beside it (verify-tests.py, deploy-wsa.sh) are part of the repo --
# CI runs verify-tests.py --strict.
/tools/gradle-8.9/
/tools/gradle-8.9-bin.zip

# Pascal core: sources are tracked here (MPL-2.0 section 3.2 needs them shipped with the binary);
# the compiler's object files are not.
core-pascal/**/*.o
core-pascal/**/*.ppu
core-pascal/**/*.a
core-pascal/**/*.so
core-pascal/**/*.ppl
core-pascal/**/*.log
